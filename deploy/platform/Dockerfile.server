FROM node:22-bookworm-slim
WORKDIR /app
COPY server/platformServer.mjs server/platformStore.mjs server/newApiClient.mjs server/managedProfiles.mjs server/importSettings.mjs ./server/
COPY docs/admin-guide.md ./docs/admin-guide.md
RUN mkdir -p /app/data && chown -R node:node /app/data
USER node
ENV STUDIO_HOST=0.0.0.0
EXPOSE 8787
CMD ["node", "server/platformServer.mjs"]

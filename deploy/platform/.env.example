# Copy to deploy/platform/.env. Never commit the populated file.
STUDIO_ORIGIN=https://studio.example.com
STUDIO_WEB_PORT=8091
NEW_API_ADMIN_PORT=3003
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
STUDIO_ENCRYPTION_KEY=

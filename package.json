{
  "name": "amazon-image-studio",
  "description": "Amazon Listing image planning and generation workspace.",
  "private": true,
  "version": "5.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ali-Aria/amazon-image-studio.git"
  },
  "homepage": "https://ali-aria.github.io/amazon-image-studio/",
  "bugs": {
    "url": "https://github.com/Ali-Aria/amazon-image-studio/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "node --import ./scripts/runtime-logging.mjs node_modules/vite/bin/vite.js",
    "admin:server": "node --import ./scripts/runtime-logging.mjs server/platformServer.mjs",
    "platform:server": "node --import ./scripts/runtime-logging.mjs server/platformServer.mjs",
    "test:platform": "node --test server/platform.check.mjs server/newApiClient.check.mjs",
    "platform:import-settings": "node server/importSettings.mjs",
    "test:platform:real": "node server/smokePlatform.mjs",
    "mock:api": "node --import ./scripts/runtime-logging.mjs scripts/mock-image-api.mjs",
    "build": "node --import ./scripts/runtime-logging.mjs node_modules/typescript/bin/tsc -b && node --import ./scripts/runtime-logging.mjs node_modules/vite/bin/vite.js build",
    "deploy:cf": "npm run build && wrangler deploy",
    "preview": "node --import ./scripts/runtime-logging.mjs node_modules/vite/bin/vite.js preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fal-ai/client": "^1.10.0",
    "core-js": "^3.49.0",
    "fflate": "^0.8.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "streamdown": "^2.5.0",
    "yaml": "^2.9.0",
    "zustand": "^5.0.5"
  },
  "overrides": {
    "mdast-util-gfm-autolink-literal": "2.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "@xmldom/xmldom": "^0.9.12",
    "autoprefixer": "^10.4.21",
    "fake-indexeddb": "^6.2.6",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^6.3.2",
    "vitest": "^4.1.5",
    "wrangler": "^4.88.0"
  }
}
